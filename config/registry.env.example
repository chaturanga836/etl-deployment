# Container registry — copy to .env or source before install.
# Customer installs pull pre-built images; dev uses compose/docker-compose.dev.yml to build locally.

REGISTRY_URL=registry.example.com/elt
IMAGE_TAG=v1.0.0

# Resolved image references (used by compose)
API_IMAGE=${REGISTRY_URL}/elt-api:${IMAGE_TAG}
FRONTEND_IMAGE=${REGISTRY_URL}/elt-frontend:${IMAGE_TAG}
INFRA_IMAGE=${REGISTRY_URL}/baas-infra:${IMAGE_TAG}
SCRAPER_IMAGE=${REGISTRY_URL}/elt-scraper:${IMAGE_TAG}

# Optional registry credentials (docker login before install)
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
