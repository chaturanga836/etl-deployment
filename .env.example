# =============================================================================
# ELT Engine - Self-hosted deployment configuration
# Copy to .env and adjust before running: cp .env.example .env
# =============================================================================

# --- Public URLs (browser-facing) ---
# When using the "full" profile, nginx listens on HTTP_PORT and routes:
#   /      -> frontend
#   /api/  -> backend
APP_URL=http://localhost
HTTP_PORT=80
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# --- Image versioning ---
IMAGE_TAG=v1.0.0
NEXT_PUBLIC_BUILD_ID=production

# --- PostgreSQL (shared by backend + Keycloak) ---
POSTGRES_USER=elt
POSTGRES_PASSWORD=changeme
# Bootstrap DB for the Postgres container (not used by apps). App DBs: scripts/init-db.sql
POSTGRES_DB=postgres
ELT_DB_NAME=elt_metadata
KEYCLOAK_DB_NAME=keycloak

# Backend SQLAlchemy connection (internal Docker hostname)
DATABASE_URL=postgresql://elt:changeme@postgres:5432/elt_metadata

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
SANDBOX_ENABLED=true

# --- Scraper microservice (Web Scraping plugin) ---
SCRAPER_PORT=8088
SCRAPER_SERVICE_URL=http://scraper-service:8080
# Leave empty for dev (scraper accepts requests without backend key verification)
SCRAPER_VERIFY_URL=
SCRAPER_INTERNAL_TOKEN=
SCRAPER_TIMEOUT_SECONDS=30

# --- Backend app ---
APP_NAME=ELT Engine
DEBUG=false

# --- Keycloak (auth profile + full profile) ---
KEYCLOAK_PORT=8081
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme

# JWKS fetch URL — internal Docker hostname is fine when Keycloak runs in the same compose stack
KC_SERVER_URL=http://keycloak:8080

# Realm and browser client (must match frontend NEXT_PUBLIC_KC_* and Keycloak import)
KC_REALM=workspace-realm
KC_WEB_CLIENT_ID=workspace-web

# Issuer in access tokens — must match the `iss` claim (usually the public Keycloak URL)
# If users log in via http://YOUR_HOST:8081, set this even when KC_SERVER_URL is internal:
# KC_ISSUER=http://YOUR_HOST:8081/realms/workspace-realm

# Legacy alias; ignored when KC_REALM is set
KC_DEV_REALM=workspace-realm

# Token endpoint for service-to-service auth
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/workspace-realm/protocol/openid-connect/token

# Keycloak admin API credentials (master realm service account)
# Create a confidential client in Keycloak master realm for tenant provisioning
KC_ADMIN_CLIENT_ID=admin-cli
KC_ADMIN_CLIENT_SECRET=

# --- Split deployment examples ---
# Backend-only on server A (Keycloak on server B):
#   docker compose --profile backend up -d --build
#   KC_SERVER_URL=http://your-keycloak-host:8081
#   KC_ISSUER=http://your-keycloak-host:8081/realms/workspace-realm
#   KC_REALM=workspace-realm
#   KEYCLOAK_TOKEN_URL=http://your-keycloak-host:8081/realms/workspace-realm/protocol/openid-connect/token
#
# Frontend-only on server C:
#   NEXT_PUBLIC_API_URL=http://your-api-host/api/v1
#   docker compose --profile frontend up -d --build
