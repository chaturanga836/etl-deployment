# DT Orch platform install — copy to .env or generate via:
#   python renderer/render.py --config schema/examples/monolith-bundled.json --out .

# --- Registry (customer installs) ---
REGISTRY_URL=ghcr.io/YOUR_GITHUB_ORG
# Optional — install.sh logs in before pull when set:
# REGISTRY_USER=github-username
# REGISTRY_TOKEN=ghp_xxxx   # PAT with read:packages
IMAGE_TAG=v1.0.0
API_IMAGE=${REGISTRY_URL}/dt-orch-api:${IMAGE_TAG}
FRONTEND_IMAGE=${REGISTRY_URL}/dt-orch-frontend:${IMAGE_TAG}
INFRA_IMAGE=${REGISTRY_URL}/baas-infra:${IMAGE_TAG}
SCRAPER_IMAGE=${REGISTRY_URL}/dt-orch-scraper:${IMAGE_TAG}

# --- Environment ---
DTORCH_ENV=development
APP_NAME=DT Orch
APP_URL=http://localhost
DEBUG=false

# --- Ports ---
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8000
FRONTEND_PORT=3001
KEYCLOAK_PORT=8081
INFRA_SERVICE_PORT=9000
SCRAPER_PORT=8088

# --- Database (bundled postgres service name: postgres) ---
POSTGRES_USER=elt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
DTORC_METADATA_DB_NAME=dtorc_metadata
DTORC_WORKSPACE_DB_NAME=dtorc_workspace
KEYCLOAK_DB_NAME=keycloak
DATABASE_URL=postgresql://elt:changeme@postgres:5432/dtorc_metadata
WORKSPACE_DATABASE_URL=postgresql://elt:changeme@postgres:5432/dtorc_workspace

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Keycloak ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme
KC_DEV_REALM=workspace-realm
KC_REALM=workspace-realm
KC_WEB_CLIENT_ID=workspace-web
KC_ADMIN_CLIENT_ID=admin-cli
KC_ADMIN_CLIENT_SECRET=
KC_SERVER_URL=http://keycloak:8080
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/workspace-realm/protocol/openid-connect/token

# --- Frontend build-time ---
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_BUILD_ID=production
NEXT_PUBLIC_KC_URL=http://localhost:8081
NEXT_PUBLIC_KC_REALM=workspace-realm
NEXT_PUBLIC_KC_CLIENT_ID=workspace-web

# --- Platform infra ---
PLATFORM_INFRA_URL=http://infra-service:9000
INTERNAL_SERVICE_TOKEN=changeme-internal-token
PROVISION_MODE=docker
DATA_PLANE_NETWORK=data-plane-net

# --- Security ---
SANDBOX_ENABLED=true
FERNET_KEY=

# --- Optional scraper ---
SCRAPER_SERVICE_URL=http://scraper-service:8080
SCRAPER_INTERNAL_TOKEN=
SCRAPER_TIMEOUT_SECONDS=30

# --- URLs ---
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1:3000
