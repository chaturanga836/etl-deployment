{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dt-orch.local/schema/deployment/v1.json",
  "title": "DT Orch Deployment",
  "type": "object",
  "required": ["version", "mode", "database", "keycloak", "app", "superadmin", "license"],
  "properties": {
    "version": { "type": "string", "const": "1" },
    "mode": { "type": "string", "enum": ["monolith", "distributed", "kubernetes"] },
    "registry": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "default": "registry.example.com/elt" },
        "image_tag": { "type": "string", "default": "v1.0.0" }
      }
    },
    "database": {
      "type": "object",
      "required": ["source", "user", "password", "metadata_db_name", "workspace_db_name", "keycloak_db_name"],
      "properties": {
        "source": { "type": "string", "enum": ["bundled", "external"] },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5432 },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "metadata_db_name": { "type": "string", "default": "dtorc_metadata" },
        "workspace_db_name": { "type": "string", "default": "dtorc_workspace" },
        "keycloak_db_name": { "type": "string", "default": "keycloak" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "external" } } },
          "then": { "required": ["host", "port"] }
        }
      ]
    },
    "monolith": {
      "type": "object",
      "properties": {
        "public_host": { "type": "string", "default": "localhost" },
        "use_proxy": { "type": "boolean", "default": true },
        "ports": {
          "type": "object",
          "properties": {
            "http": { "type": "integer", "default": 80 },
            "frontend": { "type": "integer", "default": 3000 },
            "api": { "type": "integer", "default": 8000 },
            "keycloak": { "type": "integer", "default": 8081 }
          }
        }
      }
    },
    "distributed": {
      "type": "object",
      "properties": {
        "services": {
          "type": "object",
          "properties": {
            "frontend": { "$ref": "#/$defs/serviceHost" },
            "backend": { "$ref": "#/$defs/serviceHost" },
            "auth": { "$ref": "#/$defs/serviceHost" },
            "worker": {
              "type": "object",
              "properties": {
                "host": { "type": "string" },
                "replicas": { "type": "integer", "minimum": 1, "default": 1 }
              }
            },
            "infra": { "$ref": "#/$defs/serviceHost" },
            "redis": {
              "type": "object",
              "properties": {
                "host": { "type": "string" },
                "port": { "type": "integer", "default": 6379 },
                "managed": { "type": "boolean", "default": false }
              }
            },
            "proxy": { "$ref": "#/$defs/serviceHost" }
          }
        },
        "aws": {
          "type": "object",
          "properties": {
            "region": { "type": "string" },
            "role_arn": { "type": "string" },
            "external_id": { "type": "string" },
            "provisioning": { "type": "string", "enum": ["existing", "new"] }
          }
        }
      }
    },
    "optional_features": {
      "type": "object",
      "properties": {
        "scraper": { "type": "string", "enum": ["enabled", "disabled"], "default": "enabled" },
        "keycloak": { "type": "string", "enum": ["bundled", "external"], "default": "external" }
      }
    },
    "keycloak": {
      "type": "object",
      "required": ["admin_user", "admin_password", "realm"],
      "properties": {
        "admin_user": { "type": "string" },
        "admin_password": { "type": "string" },
        "realm": { "type": "string", "default": "workspace-realm" },
        "admin_client_id": { "type": "string", "default": "admin-cli" },
        "admin_client_secret": { "type": "string", "default": "" }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "DT Orch" },
        "image_tag": { "type": "string", "default": "v1.0.0" },
        "sandbox_enabled": { "type": "boolean", "default": true }
      }
    },
    "superadmin": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": { "type": "string", "minLength": 3 },
        "password": { "type": "string", "minLength": 8 },
        "email": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 10 }
      }
    },
    "kubernetes": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string", "default": "dt-orch" },
        "ingress_host": { "type": "string" },
        "kubeconfig_path": { "type": "string" }
      }
    },
    "ssh": {
      "type": "object",
      "properties": {
        "user": { "type": "string", "default": "ubuntu" },
        "key_path": { "type": "string" },
        "remote_path": { "type": "string", "default": "/opt/etl-deployment" }
      }
    }
  },
  "$defs": {
    "serviceHost": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "aws_instance_id": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "monolith" } } },
      "then": { "required": ["monolith"] }
    },
    {
      "if": { "properties": { "mode": { "const": "distributed" } } },
      "then": { "required": ["distributed"] }
    },
    {
      "if": { "properties": { "mode": { "const": "kubernetes" } } },
      "then": { "required": ["kubernetes"] }
    }
  ]
}
